# App-shell files change every deploy but keep fixed filenames (Flutter web does
# not content-hash main.dart.js), so they must revalidate every load — otherwise
# users run stale JS for up to the max-age window after an update.
/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache

/styles.css
  Cache-Control: public, max-age=86400

/theme.js
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=604800

/*
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
